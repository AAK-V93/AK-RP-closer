// Closer Trainer v2: clean schema for the new, empty database.
// Changes only through prisma/migrations (prisma migrate dev / deploy).
// No runtime DDL, no ensure*, no repairs at read time.
// Plan: closer-arquitectura/plan-tecnico-rediseno-v2-2026-10-11.md, section 1.1.
// Not yet (each comes with its own PR): Deal, DealInstallment,
// CoachInsight, LeadMessageIdeas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum BackfillStatus {
  NONE
  RUNNING
  DONE
  ERROR
}

enum CommissionType {
  PER_CLOSE
  PCT_SALE
  PCT_CASH
}

enum ScriptOrigin {
  EMPRESA
  APP
  PROPIO
}

enum LeadStatus {
  SEGUIMIENTO
  CERRADO
  PERDIDO
}

enum CallSource {
  FATHOM
  UPLOAD
}

enum CallOutcome {
  CERRO
  SEGUIMIENTO
  PERDIDO
  REAGENDAR
}

enum CallState {
  PROCESSING
  PENDING_CONFIRM
  CONFIRMED
  IGNORED
  BRIEF_FAILED
}

enum TaskKind {
  ESCRIBIR
  LLAMAR
  COBRAR
  REUNION
}

enum TaskOrigin {
  BRIEF
  CHAT
  MANUAL
  CONFIRM
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

enum LeadEventType {
  CALL
  ATTEMPT
  STATUS
  DEAL
  NOTE
  APPLIED_CHANGE
}

enum AttemptResult {
  RESPONDIO
  NO_CONTESTO
  ENVIADO
}

enum ContactChannel {
  WHATSAPP
  LLAMADA
  EMAIL
  OTRO
}

enum ChangeOrigin {
  CHAT
  CONFIRM
  BRIEF
  RECONSTRUCTION
  FICHA
}

enum ChangeKind {
  CREATE_LEAD
  UPDATE_LEAD
  SET_STATUS
  LOG_ATTEMPT
  CREATE_TASK
  CREATE_DEAL
  SET_GOAL
}

enum ChangeStatus {
  PENDING
  APPLIED
  REJECTED
  UNDONE
  EXPIRED
}

// ---------- People and access ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  timezone     String   @default("America/Bogota")
  /// aggregates sum only in this currency; other currencies are "por confirmar" and left out of sums
  currency     String   @default("USD") @db.VarChar(3)
  createdAt    DateTime @default(now())

  fathomConnection  FathomConnection?
  counters          UserCounters?
  offers            Offer[]
  scripts           Script[]
  successCases      SuccessCase[]
  caseSources       OfferCaseSource[]
  driveConnection   GoogleDriveConnection?
  leads             Lead[]
  calls             Call[]
  callTranscripts   CallTranscript[]
  callObjections    CallObjection[]
  followUpTasks     FollowUpTask[]
  leadEvents        LeadEvent[]
  proposedChanges   ProposedChange[]
  monthStats        UserMonthStats[]
  monthlyGoals      MonthlyGoal[]
  weeklyGoals       WeeklyGoal[]
  practiceSessions  PracticeSession[]
  pushSubscriptions PushSubscription[]
}

model FathomConnection {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyEnc        String
  webhookId        String?
  webhookSecretEnc String?
  webhookToken     String?
  importSince      DateTime?
  lastSyncAt       DateTime?
  backfillCursor   String?
  backfillStatus   BackfillStatus @default(NONE)
  backfillUntil    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([webhookToken])
}

/// Google Drive with scope drive.file only (files the person picks in the
/// Picker). Its own consent and refresh token; Calendar is not touched.
model GoogleDriveConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenEnc String
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- Offers ----------

model Offer {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String          @default("")
  priceCash         Decimal?        @db.Decimal(12, 2)
  installmentsCount Int?
  installmentAmount Decimal?        @db.Decimal(12, 2)
  currency          String          @default("USD") @db.VarChar(3)
  commissionType    CommissionType?
  commissionValue   Decimal?        @db.Decimal(12, 2)
  archivedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  scripts        Script[]
  successCases   SuccessCase[]
  caseSources    OfferCaseSource[]
  leads          Lead[]
  calls          Call[]
  callObjections CallObjection[]
  monthStats     UserMonthStats[]

  @@index([userId, archivedAt])
}

model Script {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId      String?
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  title        String
  body         String
  origin       ScriptOrigin
  usesCount    Int          @default(0)
  repliesCount Int          @default(0)
  paidCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  leadEvents LeadEvent[]

  @@index([userId, offerId])
}

/// A link where an offer's success cases live (sheet or YouTube).
/// contentHash = what the source looked like at the last read; same hash → no model call.
model OfferCaseSource {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId      String
  offer        Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  rawUrl       String
  kind         CaseSourceKind
  access       CaseSourceAccess @default(PUBLIC_LINK)
  /// sheet: spreadsheet id (+ gid); YouTube: playlist, channel or video id
  externalId   String
  title        String?
  contentHash  String?
  status       CaseSourceStatus @default(PENDING)
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  cases SuccessCase[]

  @@unique([offerId, externalId])
  @@index([userId, offerId])
}

/// A success case. *Extracted = what the app read from the source (re-sync may
/// rewrite it); *User = the person's correction (null = show the extracted one;
/// re-sync never touches it). Not suggested anywhere until confirmedAt is set.
model SuccessCase {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId             String
  offer               Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sourceId            String?
  source              OfferCaseSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// yt:<videoId>, a normalized link, or row:<hash of name + link>; manual:<id> when typed by hand
  externalKey         String
  nameExtracted       String           @default("")
  profileExtracted    String?
  beforeExtracted     String?
  resultExtracted     String?
  quoteExtracted      String?
  mediaUrlExtracted   String?
  /// the exact text the case was read from; figures in results must appear here
  sourceSnippet       String?
  nameUser            String?
  profileUser         String?
  beforeUser          String?
  resultUser          String?
  quoteUser           String?
  mediaUrlUser        String?
  durationSec         Int?
  tags                String[]
  confirmedAt         DateTime?
  dismissed           Boolean          @default(false)
  missingFromSourceAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([offerId, externalKey])
  @@index([userId, offerId])
}

// ---------- People (leads) ----------

model Lead {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  /// lowercase, no accents; only for search
  nameNorm String
  phone    String?
  email    String?
  offerId  String?
  offer    Offer?     @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// PERDIDO only when marked explicitly. "Reagendar" = SEGUIMIENTO + nextMeetingAt.
  status   LeadStatus @default(SEGUIMIENTO)

  /// written by the confirmed brief
  oneLine   String? @db.VarChar(140)
  whereLeft String?
  missing   String?
  decider   String?

  lastCallId    String?
  lastCall      Call?     @relation("LeadLastCall", fields: [lastCallId], references: [id], onDelete: SetNull)
  lastCallAt    DateTime?
  lastContactAt DateTime?
  nextContactAt DateTime?
  nextMeetingAt DateTime?
  closedAt      DateTime?
  lostAt        DateTime?
  lostReason    String?

  /// denormalized, recounted on write (plan 2.2), never at read time
  attemptsSinceLastCall Int      @default(0)
  potentialCommission   Decimal? @db.Decimal(12, 2)
  /// currency of potentialCommission only
  currency              String   @default("USD") @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls           Call[]           @relation("LeadCalls")
  callObjections  CallObjection[]
  followUpTasks   FollowUpTask[]
  events          LeadEvent[]
  proposedChanges ProposedChange[]

  @@index([userId, status, nextContactAt])
  @@index([userId, status, lastContactAt(sort: Desc)])
  @@index([userId, status, closedAt])
  @@index([userId, status, lostAt])
  @@index([userId, nameNorm])
  @@index([lastCallId])
}

// ---------- Calls ----------

model Call {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId           String?
  lead             Lead?        @relation("LeadCalls", fields: [leadId], references: [id], onDelete: SetNull)
  offerId          String?
  offer            Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  source           CallSource
  sourceId         String
  title            String
  shareUrl         String?
  recordedAt       DateTime
  /// computed once at ingest; never recomputed at read time
  durationSec      Int?
  /// Fathom default summary (English, may be missing). Only the model and "Ver todo" read it.
  summaryEn        String?
  brief            Json?
  briefVersion     Int          @default(0)
  oneLine          String?      @db.VarChar(140)
  suggestedOutcome CallOutcome?
  outcome          CallOutcome?
  confirmedAt      DateTime?
  state            CallState    @default(PROCESSING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  transcript      CallTranscript?
  objections      CallObjection[]
  lastCallOf      Lead[]           @relation("LeadLastCall")
  leadEvents      LeadEvent[]
  proposedChanges ProposedChange[]

  @@unique([userId, source, sourceId])
  @@index([userId, state, recordedAt(sort: Desc)])
  @@index([leadId, recordedAt(sort: Desc)])
  @@index([userId, recordedAt])
}

/// Stored once, text only. No screen reads it.
model CallTranscript {
  callId    String @id
  call      Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  charCount Int

  @@index([userId])
}

model CallObjection {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callId  String
  call    Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  leadId  String?
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  offerId String?
  offer   Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  label   String
  quote   String?
  at      DateTime

  @@index([userId, at])
}

// ---------- Follow-up ----------

/// One OPEN task per lead: partial unique index in migration 0_init.
model FollowUpTask {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// local Bogota date: ordering, "hoy", "de días anteriores"
  dueDate   DateTime   @db.Date
  /// optional time of day
  dueAt     DateTime?
  kind      TaskKind
  note      String?
  origin    TaskOrigin
  status    TaskStatus @default(OPEN)
  doneAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, status, dueDate])
}

/// Append-only history. An attempt is type=ATTEMPT.
model LeadEvent {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  at               DateTime        @default(now())
  type             LeadEventType
  attemptResult    AttemptResult?
  channel          ContactChannel?
  scriptId         String?
  script           Script?         @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  callId           String?
  call             Call?           @relation(fields: [callId], references: [id], onDelete: SetNull)
  proposedChangeId String?
  proposedChange   ProposedChange? @relation(fields: [proposedChangeId], references: [id], onDelete: SetNull)
  note             String?         @db.VarChar(300)

  @@index([leadId, type, at])
  @@index([userId, type, at])
}

/// Every write that is not a direct tap: applied only with "Guardar".
model ProposedChange {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  callId         String?
  call           Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  origin         ChangeOrigin
  kind           ChangeKind
  payload        Json
  preview        String
  status         ChangeStatus @default(PENDING)
  undo           Json?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  leadEvents LeadEvent[]

  @@index([userId, status, createdAt])
}

// ---------- Aggregates (written on write, read ready-made) ----------

/// offerId NULL = all offers. Partial unique index for that case in 0_init.
model UserMonthStats {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// first day of the month (Bogota)
  month            DateTime @db.Date
  offerId          String?
  offer            Offer?   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  callsHeld        Int      @default(0)
  closedCount      Int      @default(0)
  lostCount        Int      @default(0)
  attemptsCount    Int      @default(0)
  salesTotal       Decimal  @default(0) @db.Decimal(12, 2)
  cashCollected    Decimal  @default(0) @db.Decimal(12, 2)
  /// sums only amounts in User.currency
  commissionEarned Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt

  @@unique([userId, month, offerId])
}

// ---------- Goals (PR 4, plan 1.1) ----------

/// One row per month and person, never deleted: past months stay as history.
/// Changing the goal during the month overwrites that month's row.
model MonthlyGoal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// first day of the month (Bogota)
  month            DateTime @db.Date
  targetCommission Decimal  @db.Decimal(12, 2)
  /// User.currency when the goal was set
  currency         String   @db.VarChar(3)
  /// path picked in «Tu camino»: { offerIds, closes, meetings, chosenAt }
  chosenPath       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, month])
}

/// Weekly targets (Monday to Sunday, Bogota). Suggested from the chosen path,
/// saved only when the person confirms them; editable.
model WeeklyGoal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday of the week (Bogota)
  weekStart       DateTime @db.Date
  meetingsTarget  Int
  followupsTarget Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, weekStart])
}

model UserCounters {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingConfirmCount Int       @default(0)
  followingCount      Int       @default(0)
  lastCloseAt         DateTime?
  lastCloseLeadName   String?
  callsSinceLastClose Int       @default(0)
  topObjectionLabel   String?
  topObjectionHits    Int?
  topObjectionOf      Int?
  updatedAt           DateTime  @updatedAt
}

// ---------- Practice and push ----------

model PracticeSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  callSection     String
  productName     String
  difficulty      String
  language        String
  overallScore    Float
  outcomeSummary  String   @default("")
  /// short lines for "Tu última práctica", written when scoring
  strengths       String?
  improve         String?
  tryLine         String?
  /// never read in lists
  transcript      Json     @default("[]")
  evaluation      Json
  criterionScores Json
  scored          Boolean  @default(false)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum CaseSourceKind {
  SHEET
  YOUTUBE_PLAYLIST
  YOUTUBE_CHANNEL
  YOUTUBE_VIDEO
}

enum CaseSourceAccess {
  PUBLIC_LINK
  DRIVE_PICKER
}

enum CaseSourceStatus {
  PENDING
  READY
  NEEDS_ACCESS
  ERROR
}
