generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String?
  createdAt    DateTime          @default(now())
  crmPrefs     Json              @default("{}")
  calendarRefreshEnc String      @default("")
  calendarSyncedAt   DateTime?
  sessions     PracticeSession[]
  coachProfile CoachProfile?
  fathomConnection FathomConnection?
  fathomRecordings FathomRecording[]
  offers       UserOffer[]
  transcripts  ClientTranscript[]
  leads        Lead[]
  leadAlerts   LeadAlert[]
  followupThreads FollowupThread[]
  commissionRules CommissionRule[]
  commissions  Commission[]
  followupPacks FollowupPack[]
  followupStars FollowupStar[]
  pushSubs     PushSubscription[]
  extractorFeedback ExtractorFeedback[]
}

model CoachProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int            @default(1)
  niche     String         @default("b2b-agencies-dfy")
  notes     Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  CoachMessage[]
}

model CoachMessage {
  id        String       @id @default(cuid())
  profileId String
  profile   CoachProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  thread    String       @default("coach")
  role      String
  content   String
  createdAt DateTime     @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, thread, createdAt])
}

model PracticeSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  callSection     String
  productName     String
  difficulty      String
  language        String
  overallScore    Float
  outcomeSummary  String   @default("")
  transcript      Json     @default("[]")
  evaluation      Json
  criterionScores Json
  scored          Boolean  @default(false)

  @@index([userId, createdAt])
}

model FathomConnection {
  id         String            @id @default(cuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyEnc         String
  lastSyncAt        DateTime?
  importSince       DateTime?
  webhookId         String            @default("")
  webhookSecretEnc  String            @default("")
  webhookToken      String            @default("")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  recordings FathomRecording[]

  @@index([webhookToken])
}

model FathomRecording {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String
  connection        FathomConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  fathomRecordingId String
  title             String
  shareUrl          String           @default("")
  recordedAt        DateTime?
  transcriptText    String           @default("")
  transcriptJson    Json             @default("[]")
  syncedAt          DateTime         @default(now())
  practiceSessionId String?

  @@unique([userId, fathomRecordingId])
  @@index([userId, recordedAt])
}

model UserOffer {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productName        String
  productDescription String
  pitchSummary       String             @default("")
  playbook           Json               @default("{}")
  commercial         Json               @default("{}")
  includeFathom      Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  transcripts        ClientTranscript[]
  commissionRules    CommissionRule[]

  @@index([userId, updatedAt])
}

model ClientTranscript {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId        String?
  offer          UserOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  source         String     @default("upload")
  title          String
  transcriptText String
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([offerId])
}

model CallRecord {
  id                String    @id @default(cuid())
  userId            String
  source            String
  sourceId          String    @default("")
  title             String
  callType          String    @default("")
  result            String    @default("")
  leadName          String    @default("")
  offerName         String    @default("")
  trainsBot         Boolean   @default(false)
  recordedAt        DateTime?
  createdAt         DateTime  @default(now())
  summary           String    @default("")
  filingStatus      String    @default("confirmed")
  filingJson        Json      @default("{}")
  confirmedAt       DateTime?
  practiceSessionId String?
  estadoAgenda      String    @default("")
  ventaTotal        Float?
  cashCollected     Float?
  saldoPendiente    Float?
  modoPago          String    @default("")

  @@unique([userId, source, sourceId])
  @@index([userId, recordedAt])
  @@index([userId, estadoAgenda])
}

model Lead {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  company       String      @default("")
  offerName     String      @default("")
  status        String      @default("nuevo")
  lastSummary   String      @default("")
  nextStep      String      @default("")
  nextStepAt    DateTime?
  objections    String      @default("")
  amountTalked  String      @default("")
  amountPaid    String      @default("")
  decider       String      @default("")
  telefono      String      @default("")
  email         String      @default("")
  canalContacto String      @default("")
  calificado    Boolean?
  razonNoCierre String      @default("")
  etapaPerdida  String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  alerts        LeadAlert[]
  followupThreads FollowupThread[]
  commissions   Commission[]

  @@index([userId, updatedAt])
}

model ExtractorFeedback {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  callRecordId   String
  campo          String
  valorExtraido  String   @default("")
  valorCorregido String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, campo])
}

model LeadAlert {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type             String
  question         String
  dueAt            DateTime
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  enJuego          Float     @default(0)
  canal            String    @default("WHATSAPP")
  mensajeSugerido  String    @default("")
  contexto         String    @default("")
  resultado        String    @default("")
  resultadoNota    String    @default("")
  intentos         Int       @default(0)
  callRecordId     String?
  libraryScriptId  String    @default("")
  threadId         String?
  thread           FollowupThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  notifiedAt       DateTime?

  @@index([userId, dueAt])
  @@index([userId, resolvedAt, notifiedAt])
  @@index([threadId])
}

model FollowupThread {
  id                       String          @id @default(cuid())
  userId                   String
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId                   String
  lead                     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offerId                  String          @default("")
  tipo                     String
  secuenciaKey             String
  pasoActual               Int             @default(0)
  estado                   String          @default("activo")
  askLost                  Boolean         @default(false)
  startedAt                DateTime        @default(now())
  pagoAt                   DateTime?
  meetingAt                DateTime?
  creadoDesdeCallRecordId  String          @default("")
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  touches                  FollowupTouch[]
  alerts                   LeadAlert[]

  @@index([userId, estado])
  @@index([leadId, estado])
}

model FollowupTouch {
  id              String         @id @default(cuid())
  threadId        String
  thread          FollowupThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fecha           DateTime       @default(now())
  canal           String         @default("WHATSAPP")
  guionUsado      String         @default("")
  libraryScriptId String         @default("")
  resultado       String         @default("enviado")
  notas           String         @default("")

  @@index([threadId, fecha])
}

model CommissionRule {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId              String?
  offer                UserOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  pctBase              Float      @default(0.03)
  umbralAcumuladoUsd   Float      @default(70000)
  pctSobreUmbral       Float      @default(0.05)
  base                 String     @default("cash_collected")
  periodoAcumulacion   String     @default("mensual")

  @@index([userId])
}

model Commission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  callRecordId String    @default("")
  fecha        DateTime  @default(now())
  oferta       String    @default("")
  venta        Float     @default(0)
  cash         Float     @default(0)
  pctAplicado  Float     @default(0)
  generada     Float     @default(0)
  cobrada      Float     @default(0)
  fechaCobro   DateTime?
  estado       String    @default("PENDIENTE")

  @@index([userId, fecha])
}

model FollowupPack {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String                  @default("")
  tags        String                  @default("")
  visibility  String                  @default("public")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  scripts     FollowupLibraryScript[]
  stars       FollowupStar[]

  @@index([visibility, updatedAt])
}

model FollowupLibraryScript {
  id            String       @id @default(cuid())
  packId        String
  pack          FollowupPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  key           String       @default("")
  type          String
  intentosMin   Int          @default(0)
  canal         String       @default("WHATSAPP")
  recomendacion String       @default("")
  guion         String
  asset         String       @default("")
  uses          Int          @default(0)
  hechos        Int          @default(0)
  cierres       Int          @default(0)
  perdidos      Int          @default(0)

  @@index([packId])
}

model FollowupStar {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId    String
  pack      FollowupPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, packId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
