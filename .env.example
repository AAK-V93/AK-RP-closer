# LiveKit Cloud --> https://cloud.livekit.io
LIVEKIT_URL=<livekit-url>
LIVEKIT_API_KEY=<livekit-api-key>
LIVEKIT_API_SECRET=<livekit-api-secret>

# Gemini API key (server-side — users don't need to enter it in the UI)
GEMINI_API_KEY=<gemini-api-key>

# Postgres (Neon / Supabase) — coaching history
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js / NextAuth
AUTH_SECRET=<random-32-chars>
NEXTAUTH_SECRET=<same-as-AUTH_SECRET>
# En producción debe ser la URL pública https://… (Fathom manda las llamadas nuevas ahí)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional; login with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alertas al closer por email. Cron diario 13:00 UTC: /api/cron/alert-digest (también empuja due).
# Push cada 15 min: GET /api/cron/push-due con Authorization: Bearer CRON_SECRET.
# No va en vercel.json: Hobby solo admite un cron al día. En cron-job.org o Vercel Pro.
# CRON_SECRET: string aleatorio que TÚ generas (openssl rand -hex 32) y pegas en Vercel.
# El cron también reintenta Fathom por si un webhook se perdió. Lo en vivo es el webhook.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Closer Trainer <noreply@tu-dominio.com>
CRON_SECRET=

# Web Push (PWA). Generar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:tu@correo.com

# Twilio no se usa. El closer se entera por Inicio + push + email.
# Al lead: botón wa.me. Al CRM: botones en la app y en la notificación.

